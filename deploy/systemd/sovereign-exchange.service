[Unit]
Description=Sovereign Exchange Core
Documentation=https://github.com/That-Tech-Geek/sovereign-exchange
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=exchange
Group=exchange
WorkingDirectory=/var/lib/sovereign-exchange
ExecStart=/opt/sovereign-exchange/bin/exchange_core
Restart=on-failure
RestartSec=2s
KillSignal=SIGTERM
TimeoutStopSec=10s

Environment=SE_JOURNAL_PATH=/var/lib/sovereign-exchange/commands.journal
Environment=SE_SNAPSHOT_DIR=/var/lib/sovereign-exchange/snapshots
Environment=SE_NODE_ID=%H

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/sovereign-exchange

LimitNOFILE=1048576
LimitNPROC=4096
TasksMax=4096

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sovereign-exchange

[Install]
WantedBy=multi-user.target
